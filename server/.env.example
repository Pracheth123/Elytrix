# Server port
PORT=5000

# MongoDB connection string (local default shown; use your Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/dr-sravanthi-portfolio

# Admin token for GET/PATCH /api/appointments — send as `x-admin-token` header.
# Generate a long random string; never commit the real value.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Allowed CORS origin(s), comma-separated
CLIENT_ORIGIN=http://localhost:5173

# TODO: clinic notification credentials (see src/notify.js) — SMTP host/user/pass
# for Nodemailer, or a WhatsApp Business API token. Left unwired on purpose.
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASS=
# CLINIC_NOTIFY_EMAIL=
